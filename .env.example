# Copy this file to `.env` and adjust the values for your environment.
# `.env` is git-ignored — never commit real secrets or API keys.
#
# ===========================================================================
# WHAT YOU ACTUALLY NEED
# ===========================================================================
# Nothing. Every value below has a working default, and the stack runs with
# no `.env` at all:
#
#   docker compose up --build
#
# One variable is worth setting, and only one is a secret:
#
#   LLM_API_KEY   OPTIONAL. Without it, dataset profiling, experiments,
#                 cross-validation, SHAP, experiment history and retrieval
#                 search all work. Only *answer generation* — POST /api/v1/ask
#                 and the AI Data Scientist — needs a credential, and without
#                 one the dashboard reports those two as unavailable in its
#                 header instead of failing. Set it in your own `.env`; it is
#                 never written here, never passed to the frontend, and never
#                 baked into an image.
#
# Everything else below is a limit or a path with a sensible default.

# ---------------------------------------------------------------------------
# Application (used now)
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Backend server (used now)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# Browser access (used now — required for the dashboard)
# ---------------------------------------------------------------------------
# The dashboard runs as a separate service, so every request the browser makes
# to this API is cross-origin and a browser blocks it without an explicit
# allowance.
#
# CORS_ALLOW_ORIGINS is an explicit, comma-separated list. It is never a
# wildcard: `*` would let any page on the internet call this API from a
# visitor's browser. An empty value disables cross-origin access entirely,
# which is what a deployment serving the dashboard from this same origin
# wants.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where the browser should send API requests. Read by the dashboard, not by
# the backend.
#
# This is inlined into the JavaScript bundle at build time, so it must be a URL
# **the browser** can resolve. Under Docker Compose that is the published host
# URL — never `http://backend:8000`, which is a Compose service name that
# resolves only inside the container network. Changing it means rebuilding:
# `docker compose up --build`.
#
# Because it is browser-visible, no secret may ever be configured this way.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Docker Compose (used now — read by docker-compose.yml only)
# ---------------------------------------------------------------------------
# Host ports the stack publishes. Change these if something already occupies
# 3000 or 8000; remember to update NEXT_PUBLIC_API_BASE_URL and
# CORS_ALLOW_ORIGINS to match, since the browser has to agree with both.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# The host interface those ports are published on.
#
# 127.0.0.1 means the stack answers this machine and nothing else. That is the
# default because the API has no authentication, accepts file uploads and runs
# training synchronously — and because a published Docker port bypasses a host
# firewall rather than being filtered by it, so `0.0.0.0` really does mean
# every machine on the network.
#
# Set this to 0.0.0.0 when you intend to serve the stack to other machines,
# and put something in front of it that authenticates.
BIND_ADDRESS=127.0.0.1

# ---------------------------------------------------------------------------
# Dataset upload limits (used now)
# Uploads above these limits are rejected before profiling. One set of limits
# covers every supported format — CSV, Excel (.xlsx) and JSON — so no format
# has a limit of its own. The readable formats themselves are an allowlist in
# Settings.supported_dataset_extensions, not an environment variable.
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_DATASET_ROWS=1000000
MAX_DATASET_COLUMNS=1000

# ---------------------------------------------------------------------------
# Experiment execution (used now)
# Records are local JSON files — MLflow and PostgreSQL are not implemented.
# Runs are synchronous, so these limits bound how long one request can take.
# ---------------------------------------------------------------------------
# Repository-relative, which is right for a checkout. Under Docker Compose the
# container overrides this with /data/experiments, on a named volume — see
# docker-compose.yml.
EXPERIMENT_STORE_DIR=ml/experiments/runs
MAX_CV_FOLDS=10
MAX_CANDIDATE_MODELS=6
MAX_EXPERIMENT_ROWS=200000
EXPLANATION_ROWS=500

# ---------------------------------------------------------------------------
# Retrieval (used now)
# The default embedding provider runs offline: no API key, no model download,
# no network. Set RAG_EMBEDDING_PROVIDER=sentence_transformer only after
# installing the optional dependency, and rebuild the index afterwards —
# vectors from two providers are not comparable.
# Qdrant and any other vector database are not implemented.
#
# These also govern the public API. RAG_TOP_K is the default used when a
# request to POST /api/v1/search or /api/v1/ask omits `top_k`, and
# RAG_MAX_QUERY_LENGTH is the longest query either endpoint accepts.
# ---------------------------------------------------------------------------
# Repository-relative, as above. The container overrides this with
# /data/rag-index, on a named volume, and rebuilds it incrementally at every
# start so a fresh volume is never empty.
RAG_INDEX_DIR=rag/index
RAG_EMBEDDING_PROVIDER=hashing
RAG_EMBEDDING_DIMENSION=512
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.0
RAG_MAX_QUERY_LENGTH=2000

# ---------------------------------------------------------------------------
# Language model (used now)
#
# LLM_API_KEY is the ONLY credential this project reads. Leave it empty here
# and set it in your own `.env`, which is git-ignored. Never commit a real key.
#
# Everything except generation works without one: the package imports, the
# whole test suite runs, the API starts, and retrieval — including
# POST /api/v1/search — returns evidence. Only an actual answer request needs
# a key. Without one, POST /api/v1/ask answers 503 with a clear configuration
# error, and nothing else is affected.
#
# None of these settings can be supplied by an API request. There is no
# request field for a key, an endpoint, a model, a system prompt, or a switch
# that disables grounding or citation validation.
#
# LLM_BASE_URL points the same provider at any OpenAI-compatible endpoint —
# Azure OpenAI, vLLM, Ollama, LM Studio, OpenRouter — including a model
# running locally. Leave it empty for OpenAI itself.
#
# The bounded agent in `agent/` plans through these same settings — see the
# AGENT_* section below. No LangChain, LangGraph, AutoGen, CrewAI, multi-agent
# system, streaming or conversation memory is implemented.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=900
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_RETRIEVED_CHUNKS=6
LLM_MAX_CONTEXT_CHUNKS=6
LLM_MAX_CONTEXT_CHARS=12000
LLM_MIN_EVIDENCE_SCORE=0.05

# Set to 1 to enable the optional real-provider smoke test. Off by default so
# a normal test run never contacts a provider or spends anything.
# RUN_LLM_INTEGRATION=

# ---------------------------------------------------------------------------
# Agent (used now)
#
# The bounded tool-calling agent in `agent/`. These are hard limits on one
# question: reaching any of them ends the run with a structured partial
# result. None can be raised by a request, by the planner, or by anything a
# tool observed — a limit a model can talk its way past is not a limit.
#
# There is no credential here. The agent plans through the same LLM_* provider
# settings above, and holds no key of its own.
#
# These are the server's ceiling for POST /api/v1/agent/ask. A request may
# name max_tool_calls, max_iterations or max_context_chars to make one run
# smaller; a value above the limit set here is rejected with a 422.
#
# No agent framework is installed: LangChain, LangGraph, AutoGen and CrewAI
# are all not implemented.
# ---------------------------------------------------------------------------
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_ITERATIONS=8
AGENT_MAX_CONTEXT_CHARS=24000
AGENT_MAX_ANSWER_LENGTH=4000
AGENT_MAX_OBSERVATION_CHARS=6000
AGENT_PLANNER_TEMPERATURE=0.0
AGENT_PLANNER_TIMEOUT_SECONDS=30
AGENT_ANSWER_TIMEOUT_SECONDS=45
AGENT_PLANNER_MAX_OUTPUT_TOKENS=400

# ---------------------------------------------------------------------------
# Planned — not read by the application yet.
# Placeholders are listed here so the intended configuration surface is
# visible while the corresponding features are being built.
# ---------------------------------------------------------------------------
# POSTGRES_URL=
# QDRANT_URL=
# MLFLOW_TRACKING_URI=
