# Copy this file to `.env` and adjust the values for your environment.
# `.env` is git-ignored — never commit real secrets or API keys.

# ---------------------------------------------------------------------------
# Application (used now)
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Backend server (used now)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# Dataset upload limits (used now)
# Uploads above these limits are rejected before profiling.
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_DATASET_ROWS=1000000
MAX_DATASET_COLUMNS=1000

# ---------------------------------------------------------------------------
# Experiment execution (used now)
# Records are local JSON files — MLflow and PostgreSQL are not implemented.
# Runs are synchronous, so these limits bound how long one request can take.
# ---------------------------------------------------------------------------
EXPERIMENT_STORE_DIR=ml/experiments/runs
MAX_CV_FOLDS=10
MAX_CANDIDATE_MODELS=6
MAX_EXPERIMENT_ROWS=200000
EXPLANATION_ROWS=500

# ---------------------------------------------------------------------------
# Retrieval (used now)
# The default embedding provider runs offline: no API key, no model download,
# no network. Set RAG_EMBEDDING_PROVIDER=sentence_transformer only after
# installing the optional dependency, and rebuild the index afterwards —
# vectors from two providers are not comparable.
# Qdrant and any other vector database are not implemented.
# ---------------------------------------------------------------------------
RAG_INDEX_DIR=rag/index
RAG_EMBEDDING_PROVIDER=hashing
RAG_EMBEDDING_DIMENSION=512
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.0

# ---------------------------------------------------------------------------
# Planned — not read by the application yet.
# Placeholders are listed here so the intended configuration surface is
# visible while the corresponding features are being built.
# ---------------------------------------------------------------------------
# POSTGRES_URL=
# QDRANT_URL=
# LLM_API_KEY=
# MLFLOW_TRACKING_URI=
