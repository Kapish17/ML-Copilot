# Where the FastAPI backend is reachable from the browser.
#
# This is the only configuration the frontend has, and it is deliberately
# public (NEXT_PUBLIC_) because the browser makes the requests. No backend
# secret — no LLM_API_KEY, no store path, nothing from the server's .env —
# belongs in this file or anywhere else in this directory.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
