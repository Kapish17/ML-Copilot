# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
MANIFEST

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# ---------------------------------------------------------------------------
# Testing, linting and type checking caches
# ---------------------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.cache/
.hypothesis/

# ---------------------------------------------------------------------------
# Node / Next.js (frontend)
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ---------------------------------------------------------------------------
# Environment files
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log

# ---------------------------------------------------------------------------
# Datasets
# ---------------------------------------------------------------------------
data/raw/*
data/processed/*
!data/**/.gitkeep
*.csv
*.tsv
*.parquet
*.feather
*.db
*.sqlite3

# The one exception, and it has to be an exception: `examples/` holds the demo
# data the README, the demo script and the tests all use. It is synthetic,
# generated by `examples/generate_demo_dataset.py`, small and deterministic —
# the opposite of the local working datasets the rule above exists to keep out.
# Without this line the blanket `*.csv` would silently leave the demo out of
# every checkout.
!examples/*.csv
!examples/*.tsv

# ---------------------------------------------------------------------------
# Model artifacts and experiment tracking
# ---------------------------------------------------------------------------
*.pkl
*.joblib
*.h5
*.onnx
*.pt
*.pth
*.ckpt
# Stored experiment records are local history, not source. The code that
# writes them lives in ml/experiments/ and is tracked.
ml/experiments/runs/
# Persisted models. Derived data too — a run can be repeated — and binary
# pickles besides, which do not belong in a source repository under any
# circumstances: unpickling executes code, so a committed model would be a
# committed executable that every checkout trusts.
ml/experiments/models/
mlruns/
mlartifacts/

# ---------------------------------------------------------------------------
# Vector store / local service volumes
# ---------------------------------------------------------------------------
# The built retrieval index is derived data: it can be rebuilt from the
# documentation and the experiment store at any time. The code that builds it
# lives in rag/ and is tracked.
rag/index/
qdrant_storage/
pgdata/

# ---------------------------------------------------------------------------
# IDE and editor files
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ---------------------------------------------------------------------------
# OS files
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
